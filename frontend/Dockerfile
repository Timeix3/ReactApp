
# Используем легкий образ Node.js
FROM node:20-alpine

# Рабочая директория внутри контейнера
WORKDIR /app

# Копируем файлы зависимостей (для кэширования слоев Docker)
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь исходный код
COPY . .

# Открываем порт. Vite по умолчанию использует 5173
EXPOSE 8080

# Запускаем dev-сервер. 
# ВАЖНО: --host 0.0.0.0 обязателен, иначе сервер будет слушать только localhost внутри контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]